;==================================================
;原生事件：首次进入TRAIN时提醒口上文本设置，不经KOJO消息分发
;==================================================
@EVENTTRAIN
#PRI
	CALL AME36_WARN_TEXT_SETTING
	CALL AME36_WARN_REAL_TIME_SAVE
	RETURN 0

;==================================================
;占位提醒：仅本剧本启用时使用FIRSTTIME(4)提示一次
;不检测文本开关；标记随燐的CFLAG存档
;==================================================
@AME36_WARN_TEXT_SETTING
	#LOCALSIZE 1
	#LOCALSSIZE 1
	#DIM ORIN_INDEX
	#DIM PREV_TARGET
	ORIN_INDEX = GETCHARA(36)
	SIF ORIN_INDEX < 0
		RETURN 0
	SIF CFLAG:ORIN_INDEX:SCRIPT_SELECTOR_AMER != 3
		RETURN 0
	;--------------------------------------------------
	;FIRSTTIME读写当前TARGET，临时指定为燐并在结束后恢复
	;--------------------------------------------------
	PREV_TARGET = TARGET
	TARGET = ORIN_INDEX
	IF AME36_FIRSTTIME(4)
		;--------------------------------------------------
		;占位文本，后续由作者调整
		;--------------------------------------------------
		CALL COLORMESSAGE("注意：本口上的部分自定义机制依赖口上文本开启。游玩期间请勿关闭口上文本，否则可能导致计数、重置及行为限制异常。", C_RED, 2, 1)
		FORCEWAIT
	ENDIF
	TARGET = PREV_TARGET
	RETURN 0

;==================================================
;普通日初已推进日期后，检查首次启用是否为中途切换
;==================================================
@EVENTTRAIN
#LATER
	CALL AME36_WARN_MIDGAME_SWITCH
	RETURN 0

;==================================================
;中途切换警告沿用FIRSTTIME(3)，首次正常开局也消费标记
;==================================================
@AME36_WARN_MIDGAME_SWITCH
	#LOCALSIZE 1
	#LOCALSSIZE 1
	#DIM ORIN_INDEX
	#DIM PREV_TARGET
	ORIN_INDEX = GETCHARA(36)
	SIF ORIN_INDEX < 0
		RETURN 0
	SIF CFLAG:ORIN_INDEX:SCRIPT_SELECTOR_AMER != 3
		RETURN 0
	PREV_TARGET = TARGET
	TARGET = ORIN_INDEX
	IF AME36_FIRSTTIME(3) && DAY > 1
		CALL COLORMESSAGE("警告：本口上仅支持在游戏开始前的选择界面启用，在任何时间切换均会导致大量机制发生错误", C_RED, 2, 1)
		FORCEWAIT
	ENDIF
	TARGET = PREV_TARGET
	RETURN 0

;==================================================
;开启非就寝时段存档时，用FIRSTTIME(5)警告一次
;关闭插件时不消费标记；不自动修改玩家设置
;==================================================
@AME36_WARN_REAL_TIME_SAVE
	#LOCALSIZE 1
	#LOCALSSIZE 1
	#DIM ORIN_INDEX
	#DIM PREV_TARGET
	ORIN_INDEX = GETCHARA(36)
	SIF ORIN_INDEX < 0
		RETURN 0
	SIF CFLAG:ORIN_INDEX:SCRIPT_SELECTOR_AMER != 3 || !Real_Time_Save
		RETURN 0
	PREV_TARGET = TARGET
	TARGET = ORIN_INDEX
	IF AME36_FIRSTTIME(5)
		;--------------------------------------------------
		;占位文本，后续由作者调整
		;--------------------------------------------------
		CALL COLORMESSAGE("警告：当前已开启“非就寝时段存档”。本口上不支持该功能，日间存读档可能导致计数及其他自定义机制异常。请关闭该功能，使用起床前主界面的普通存读档。", C_RED, 2, 1)
		FORCEWAIT
	ENDIF
	TARGET = PREV_TARGET
	RETURN 0
