            CALL AME36_COMPLETION_PRINT(AME36_COM_RECOLLECTION(CFLAG:AME36_RECOLLECTION_610, 0, 0, 2, 5, 10, -4), 400, 1, CFLAG:AME36_RECOLLECTION_610, SHOW_COM_EXP)
            PRINTPLAINFORM [614]采购食材　　　　
            CALL AME36_COMPLETION_PRINT(AME36_COM_RECOLLECTION(CFLAG:AME36_RECOLLECTION_614, 0, 0, 1, 2, 5, -8), 200, 1, CFLAG:AME36_RECOLLECTION_614, SHOW_COM_EXP)
            PRINTPLAINFORM [615]吃便当　　　　　
            CALL AME36_COMPLETION_PRINT(AME36_COM_RECOLLECTION(CFLAG:AME36_RECOLLECTION_615, 0, 0, 0, 66, 200, 80), 500, 1, CFLAG:AME36_RECOLLECTION_615, SHOW_COM_EXP)
            PRINTPLAINFORM [617]邀请去甜品店　　
            CALL AME36_COMPLETION_PRINT(AME36_COM_RECOLLECTION(CFLAG:AME36_RECOLLECTION_617, 0, 0, 1, 2, 5, -16), 400, 1, CFLAG:AME36_RECOLLECTION_617, SHOW_COM_EXP)
            PRINTPLAINFORM [621]钓鱼　　　　　　
            CALL AME36_COMPLETION_PRINT(AME36_COM_RECOLLECTION(CFLAG:AME36_RECOLLECTION_621, 0, 0, 180, 580, 1300, 845), 2000, 1, CFLAG:AME36_RECOLLECTION_621, SHOW_COM_EXP)
            PRINTPLAINFORM [626]送礼　　　　　　
            CALL AME36_COMPLETION_PRINT(AME36_COM_RECOLLECTION(CFLAG:AME36_RECOLLECTION_626, 0, 5, 10, 20, 50, 1), 2500, 1, CFLAG:AME36_RECOLLECTION_626, SHOW_COM_EXP)
        ENDIF
    ELSEIF CURRENT_MODE == "555"

    ELSEIF CURRENT_MODE == "666"
        PRINTFORM 与阿燐一起度过的时光　
        CALL AME36_COMPLETION_PRINT(AME36_PERSISTENCE_RECOLLECTION(), 10000, 1)
        PRINTBUTTON "喝过酒的种类　　　　　", "901"
        CALL AME36_COMPLETION_PRINT(AME36_ALCOHOL_RECOLLECTION(), 1000, 1)
        PRINTBUTTON "做过料理的种类　　　　", "902"
        CALL AME36_COMPLETION_PRINT(AME36_DISH_RECOLLECTION(), 2000, 1)
    ENDIF
    DRAWLINE
    ;--------------------------------------------------
    ;这里是表尾的选项部分
    ;--------------------------------------------------
    IF CURRENT_PAGE == 1
        SETCOLOR C_L_GRAY
        PRINTPLAIN [111]　上一页
        RESETCOLOR
    ELSE
        PRINTBUTTON "[111]　上一页", "111"
    ENDIF
    PRINT 　　　　
    PRINTBUTTON "[222]　结束回忆", "222"
    PRINT 　　　
    IF CURRENT_PAGE == MAX_PAGE
        SETCOLOR C_L_GRAY
        PRINTPLAIN [333]　下一页
        RESETCOLOR
    ELSE
        PRINTBUTTON "[333]　下一页", "333"
    ENDIF
    PRINTL
    IF CURRENT_MODE == "444"
        SETCOLOR C_L_GRAY
        PRINTPLAIN [444]　ＣＯＭ相关
        RESETCOLOR
    ELSE
        PRINTBUTTON "[444]　ＣＯＭ相关", "444"
    ENDIF
    PRINT 　　
    IF CURRENT_MODE == "555"
        SETCOLOR C_L_GRAY
        PRINTPLAIN [555]　特殊事件
        RESETCOLOR
    ELSE
        PRINTBUTTON "[555]　特殊事件", "555"
    ENDIF
    PRINT 　　　
    IF CURRENT_MODE == "666"
        SETCOLOR C_L_GRAY
        PRINTPLAIN [666]　杂项
        RESETCOLOR
    ELSE
        PRINTBUTTON "[666]　杂项", "666"
    ENDIF
    INPUTS
    SIF RESULTS == "777"
        SHOW_COM_EXP = !SHOW_COM_EXP
    SIF RESULTS == "222"
        RETURN 1
    SIF RESULTS == "111"
        CURRENT_PAGE = MAX(CURRENT_PAGE - 1, 1)
    SIF RESULTS == "333"
        CURRENT_PAGE = MIN(CURRENT_PAGE + 1, MAX_PAGE)
    IF GROUPMATCH(RESULTS, "444", "555", "666")
        CURRENT_MODE '= RESULTS
        CURRENT_PAGE = 1
        SELECTCASE RESULTS
            CASE "444"
                MAX_PAGE = 3
            CASE "555"
                MAX_PAGE = 1
            CASE "666"
                MAX_PAGE = 1
        ENDSELECT
    ENDIF
    ;--------------------------------------------------
    ;酒和料理的完成度显示
    ;--------------------------------------------------
    IF CURRENT_MODE == "666"
        IF RESULTS == "901"
            DRAWLINE
            PRINTFORML □都一起喝过什么酒呢□
            CALL AME36_ALCOHOL_HISTORY_PRINT(TARGET)
            PRINTW
        ELSEIF RESULTS == "902"
            VARSET LOCAL
            TDISH_NAME '= DISH_NAME
            TDISH_TASTE '= DISH_TASTE
            TDISH_TYPE '= DISH_TYPE
            TDISH_COMMENT '= DISH_COMMENT
            FOR LOCAL, 0, 11
    	        TDISH_ING:LOCAL = DISH_ING:LOCAL
            NEXT
            TDISH_TIME = DISH_TIME
            TDISH_MAXLIMIT = DISH_MAXLIMIT

            DRAWLINE
            PRINTFORML □都一起做过什么料理呢□
            PRINTFORML ＜轻食＞
            CALL AME36_DISH_HISTORY_PRINT_RANGE(TARGET, AME36_DISH_HISTORY_FIRST_ID, 200)
            PRINTL
            PRINTFORML ＜主食＞
            CALL AME36_DISH_HISTORY_PRINT_RANGE(TARGET, 201, 300)
            PRINTL
            PRINTFORML ＜甜点＞
            CALL AME36_DISH_HISTORY_PRINT_RANGE(TARGET, 301, 350)
            PRINTL
            PRINTFORML ＜跳蛋？＞
            CALL AME36_DISH_HISTORY_PRINT_RANGE(TARGET, 351, AME36_DISH_SPECIAL_OFFSET - 1)
            PRINTL
            PRINTFORML ＜固有料理＞
            CALL AME36_DISH_HISTORY_PRINT_RANGE(TARGET, AME36_DISH_SPECIAL_OFFSET + 1, AME36_DISH_HISTORY_LAST_ID, 1)
            SIF !RESULT
                PRINTFORML 还什么都没有哦
            PRINTW

            DISH_NAME '= TDISH_NAME
            DISH_TASTE '= TDISH_TASTE
            DISH_TYPE '= TDISH_TYPE
            DISH_COMMENT '= TDISH_COMMENT
            FOR LOCAL, 0, 11
            	DISH_ING:LOCAL = TDISH_ING:LOCAL
            NEXT
            DISH_TIME = TDISH_TIME
            DISH_MAXLIMIT = TDISH_MAXLIMIT
        ENDIF
    ENDIF
    CLEARLINE LINECOUNT - START_LINECOUNT
    GOTO RECOLLECTION_LOOP

    CALL M_KOJO_AME_COLOR_K36
    RETURN 1

;==================================================
;按本体可饮用目录显示酒名，标记按酒数据ID查询
;沿用本体ITEMNAME_TR翻译，不维护额外赋名表
;==================================================
@AME36_ALCOHOL_HISTORY_PRINT(CHARA)
    #LOCALSIZE 1
    #LOCALSSIZE 1
    #DIM CHARA
    #DIM DYNAMIC ALCOHOL_ID
    #DIM DYNAMIC ITEM_ID
    SIF CHARA < 0 || CHARA >= CHARANUM
        RETURN 0
    SIF NO:CHARA != 36
        RETURN 0
    LOCAL = 0
    FOR ALCOHOL_ID, AME36_ALCOHOL_HISTORY_FIRST_ID, AME36_ALCOHOL_HISTORY_LAST_ID + 1
        ITEM_ID = AME36_ALCOHOL_ITEM_INDEX(ALCOHOL_ID)
        SIF ITEM_ID < 0
            CONTINUE
        LOCALS '= ITEMNAME_TR(ITEM_ID)
        SIF LOCALS == ""
            CONTINUE
        SIF AME36_ALCOHOL_HISTORY_HAS(CHARA, ALCOHOL_ID)
            SETCOLOR C_GREEN
        STRLENFORM %LOCALS%
        PRINTFORM %LOCALS%%"　" * MAX(8 - RESULT / 2, 1)%
        RESETCOLOR
        LOCAL += 1
        SIF LOCAL % 3 == 0
            PRINTL
    NEXT
    SIF LOCAL % 3
        PRINTL
    RETURN LOCAL

;==================================================
;按本体目录显示料理，完成标记始终按料理编号查询
;RECORDED_ONLY用于仅显示已记录的固有料理，允许剧本自定义食谱
;==================================================
@AME36_DISH_HISTORY_PRINT_RANGE(CHARA, FIRST_ID, LAST_ID, RECORDED_ONLY = 0)
    #LOCALSIZE 1
    #LOCALSSIZE 1
    #DIM CHARA
    #DIM FIRST_ID
    #DIM LAST_ID
    #DIM RECORDED_ONLY
    #DIM DYNAMIC DISH_ID
    SIF CHARA < 0 || CHARA >= CHARANUM
        RETURN 0
    SIF NO:CHARA != 36
        RETURN 0
    FIRST_ID = MAX(FIRST_ID, AME36_DISH_HISTORY_FIRST_ID)
    LAST_ID = MIN(LAST_ID, AME36_DISH_HISTORY_LAST_ID)
    SIF FIRST_ID > LAST_ID
        RETURN 0
    LOCAL = 0
    FOR DISH_ID, FIRST_ID, LAST_ID + 1
        SIF GROUPMATCH(DISH_ID, AME36_DISH_DEBUG_ID, AME36_DISH_SPECIAL_OFFSET)
            CONTINUE
        SIF RECORDED_ONLY && !AME36_DISH_HISTORY_HAS(CHARA, DISH_ID)
            CONTINUE
        SIF !RECORDED_ONLY && !QOL_DISH_HAS_DATA(DISH_ID)
            CONTINUE
        CALL DISHDATA(DISH_ID)
        SIF DISH_NAME == ""
            CONTINUE
        SIF AME36_DISH_HISTORY_HAS(CHARA, DISH_ID)
            SETCOLOR C_GREEN
        STRLENFORM %DISH_NAME%
        PRINTFORM %DISH_NAME%%"　" * MAX(10 - RESULT / 2, 1)%
        RESETCOLOR
        LOCAL += 1
        SIF LOCAL % 4 == 0
            PRINTL
    NEXT
    SIF LOCAL % 4
        PRINTL
    RETURN LOCAL

;==================================================
;显示完成度，可按需附加COM回忆曲线的原始经验输入
;==================================================
@AME36_COMPLETION_PRINT(PROGRESS, MAX_VALUE, IS_L, COM_EXP = 0, SHOW_EXP = 0)
    #LOCALSIZE 1
    #LOCALSSIZE 1
    #DIM PROGRESS
    #DIM MAX_VALUE
    #DIM IS_L
    #DIM COM_EXP
    #DIM SHOW_EXP
    IF SHOW_EXP
        LOCALS = ({PROGRESS}/{MAX_VALUE} + {COM_EXP})
    ELSE
        LOCALS = ({PROGRESS}/{MAX_VALUE})
    ENDIF
    IF PROGRESS == MAX_VALUE
        CALL COLORMESSAGE(LOCALS, C_GREEN, IS_L)
    ELSE
        IF IS_L
            PRINTFORML %LOCALS%
        ELSE
            PRINTFORM %LOCALS%
        ENDIF
    ENDIF
    RETURN 1