#DIM CONST AME36_PALAM_TEMP_21 = 1039
#DIM CONST AME36_PALAM_TEMP_30 = 1040
#DIM CONST AME36_PALAM_TEMP_31 = 1041
#DIM CONST AME36_PALAM_TEMP_32 = 1042
#DIM CONST AME36_PALAM_TEMP_33 = 1043
;--------------------------------------------------
;1046 - 用于指示是否通过临时设置为睡眠中（当然还改了行动）来取消某些指令的参与
;--------------------------------------------------
#DIM CONST AME36_SLEEPY_MAGIC = 1046
;--------------------------------------------------
;1047 - 用于记录所在位置与是否在时停中被搬动过
;--------------------------------------------------
#DIM CONST AME36_TP_INDEX = 1047
;--------------------------------------------------
;1048 - 记录上一回合是否为时停
;--------------------------------------------------
#DIM CONST AME36_TIMESTOP_PREV = 1048
;--------------------------------------------------
;1049 ~ 1051 - 临时储存情绪和理性，阻止未经许可的上升
