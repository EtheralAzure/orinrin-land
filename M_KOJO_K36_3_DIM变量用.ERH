;--------------------------------------------------
;1250 ~ 1251 - 饮酒历史，每槽使用bit0～62，按本体酒数据ID自动寻址
;酒数据ID1～126分别映射到两块；物品编号须先转换，不保存名称或次数
;--------------------------------------------------
#DIM CONST AME36_ALCOHOL_HISTORY_BEGIN = 1250
#DIM CONST AME36_ALCOHOL_HISTORY_BLOCKS = 2
#DIM CONST AME36_ALCOHOL_HISTORY_BITS = 63
#DIM CONST AME36_ALCOHOL_HISTORY_FIRST_ID = 1
#DIM CONST AME36_ALCOHOL_HISTORY_LAST_ID = AME36_ALCOHOL_HISTORY_FIRST_ID + AME36_ALCOHOL_HISTORY_BLOCKS * AME36_ALCOHOL_HISTORY_BITS - 1
;--------------------------------------------------
;1252 ~ 1259 - 料理历史，每槽使用bit0～62，按料理编号自动寻址
;料理编号101～604分别映射到8块，不保存名称、次数或日期
;299为DEBUG料理，400为固有料理编号的基准，不记录这两个编号
;--------------------------------------------------
#DIM CONST AME36_DISH_HISTORY_BEGIN = 1252
#DIM CONST AME36_DISH_HISTORY_BLOCKS = 8
#DIM CONST AME36_DISH_HISTORY_BITS = 63
#DIM CONST AME36_DISH_HISTORY_FIRST_ID = 101
#DIM CONST AME36_DISH_HISTORY_LAST_ID = AME36_DISH_HISTORY_FIRST_ID + AME36_DISH_HISTORY_BLOCKS * AME36_DISH_HISTORY_BITS - 1
#DIM CONST AME36_DISH_SPECIAL_OFFSET = 400
#DIM CONST AME36_DISH_SELF_ID = AME36_DISH_SPECIAL_OFFSET + 36
#DIM CONST AME36_DISH_DEBUG_ID = 299
;--------------------------------------------------
;1298 - 陪伴值，用于在一日结束后决定相守值的增加，每日开始时清零
;--------------------------------------------------
#DIM CONST AME36_ATTENTION = 1298
;--------------------------------------------------
;1299 - 相守值，在一日结束后，根据本日陪伴值分段式上升
;构成回忆值的一部分
;--------------------------------------------------
#DIM CONST AME36_PERSISTENCE = 1299

