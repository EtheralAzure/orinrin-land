#DIM CONST CUP_SIZE_AMER = 105
#DIM CONST ALCOHOL_TOLERANCE_AMER = 121
#DIM CONST FLIRTATIOUS_AMER = 142
#DIM CONST HYPNOTISM1_AMER = 298
#DIM CONST HYPNOTISM2_AMER = 299

;==================================================
;TCVAR系
;==================================================
;数组用途：角色临时状态
;别名说明：本口上别名 → 游戏内名称（中文／用途）
;MDMA_AMER → TCVAR:催情薬（催情药状态）
;APHRODISIAC_AMER → TCVAR:媚薬（媚药状态）
;DRUNK_AMER → TCVAR:烂醉（烂醉状态）
;GRAVITY_AMER → TCVAR:引力点（移动引力点）
;FORCED_AMER → TCVAR:强行（强行状态）
;DISH_RATING_AMER → TCVAR:料理評価値（料理评价值）
;HUNGRY_TIME_AMER → TCVAR:空腹時刻（空腹时刻）
;HUNGRY_TIME_DESSERT_AMER → TCVAR:甜点空腹時刻（甜点空腹时刻）
;JOB_START_AMER → TCVAR:工作開始（工作开始时刻）
;JOB_END_AMER → TCVAR:工作結束（工作结束时刻）
;MUSHI_TRACK_AMER → TCVAR:斗虫参加可否（斗虫参与条件）
;--------------------------------------------------
#DIM CONST MDMA_AMER = 139
#DIM CONST APHRODISIAC_AMER = 140
#DIM CONST DRUNK_AMER = 145
#DIM CONST GRAVITY_AMER = 194
#DIM CONST FORCED_AMER = 200
#DIM CONST DISH_RATING_AMER = 306
#DIM CONST HUNGRY_TIME_AMER = 312
#DIM CONST HUNGRY_TIME_DESSERT_AMER = 313
#DIM CONST JOB_START_AMER = 325
#DIM CONST JOB_END_AMER = 326
#DIM CONST MUSHI_TRACK_AMER = 334

;==================================================
;TFLAG系
;==================================================
;数组用途：全局临时状态与指令中间结果
;别名说明：本口上别名 → 游戏内名称（中文／用途）
;TRAIN_COMABLE_AMER → TFLAG:調教中COMABLE管理（调教中指令可用管理）
;KOJO_COM_RESULT_AMER → TFLAG:口上によるCOM成否判定（口上覆盖的指令成否判定）
;COM_BRANCH_AMER → TFLAG:SELECTCOM的分岐（指令结果分支）
;COM_DETAIL_AMER → TFLAG:不影响SOURCE等的SELECTCOM的分岐（不影响SOURCE等的指令分支）
;PUBLIC_BATH_FLAGS_AMER → TFLAG:大衆浴場FLAG（大众浴场状态标志）
;OLD_HELL_SPRING_FLAGS_AMER → TFLAG:旧地獄温泉FLAG（旧地狱温泉状态标志）
;--------------------------------------------------
#DIM CONST TRAIN_COMABLE_AMER = 100
#DIM CONST KOJO_COM_RESULT_AMER = 192
#DIM CONST COM_BRANCH_AMER = 193
#DIM CONST COM_DETAIL_AMER = 194
#DIM CONST PUBLIC_BATH_FLAGS_AMER = 209
#DIM CONST OLD_HELL_SPRING_FLAGS_AMER = 211

;==================================================
;TIME系
;==================================================
;数组用途：时刻与天气
;别名说明：本口上别名 → 游戏内名称（中文／用途）
;MINUTES_AMER → TIME:時間（当天时刻（分钟））
;TOTAL_MINUTES_AMER → TIME:時間進行管理（时间推进管理）
;DAY_SECTION_AMER → TIME:時間帯（时间段）
;GETUP_TIME_AMER → TIME:MASTERの起床予定時刻（主角预计起床时刻）
;WEATHER_AMER → TIME:天気（天气）
;EXTRA_WEATHER_AMER → TIME:虹（虹／额外天候标志）
;--------------------------------------------------
#DIM CONST MINUTES_AMER = 0
#DIM CONST TOTAL_MINUTES_AMER = 1
#DIM CONST DAY_SECTION_AMER = 2
#DIM CONST GETUP_TIME_AMER = 3
#DIM CONST WEATHER_AMER = 5
#DIM CONST EXTRA_WEATHER_AMER = 7

;※※※※※※※※※※※※※※※※※※※※※※※※※※※※
;CFLAG别名，用于增加可读性
;※※※※※※※※※※※※※※※※※※※※※※※※※※※※

;==================================================
;1001 ~ 1010 - 设置系
;==================================================
;1001 - 每日刷新的一个随机数，用于某些以日为单位的随机
;--------------------------------------------------
#DIM CONST AME36_RAND_TODAY = 1001

;==================================================
;1011 ~ 1020 - 状态系
;除了钱以外上限都是10000
;==================================================
;1011 - 阿燐的钱钱
;谁说只有MASTER才能有钱钱的
;--------------------------------------------------
#DIM CONST AME36_PURSE = 1011
;--------------------------------------------------
;1013 - 阿燐的创伤
;对阿燐或家人做坏事会增长，会影响阿燐的行动
;--------------------------------------------------
#DIM CONST AME36_TRAUMA = 1012
;--------------------------------------------------
;1014 - 阿燐的反感
;MASTER做出格的事被发现会增长，高反感下阿燐会时刻关注家人是否处于危险中，各种属性也难以增长
;--------------------------------------------------
#DIM CONST AME36_CONTEMPT = 1013



;==================================================
;1021 ~ 1090 - 修改原版机制用
;==================================================
;1021 - 积攒度临时储存，用于禁用自慰显示
;--------------------------------------------------
#DIM CONST AME36_HORNINESS_TEMP = 1021
;--------------------------------------------------
;1022, 1023 - 空腹时刻储存，用于禁用千里来抢食
;--------------------------------------------------
#DIM CONST AME36_HUNGRY_TIME_TEMP = 1022
#DIM CONST AME36_HUNGRY_TIME_DESSERT_TEMP = 1023

;--------------------------------------------------
;1030 - 检测此回合是否被选为TARGET
;--------------------------------------------------
#DIM CONST AME36_IS_TARGET = 1030
;--------------------------------------------------
;1031 ~ 1043 - 临时储存PALAM信息，阻止未经许可的上升
;此外，许可一切快感与润滑的上升
;--------------------------------------------------
#DIM CONST AME36_PALAM_TEMP_10 = 1031
#DIM CONST AME36_PALAM_TEMP_11 = 1032
#DIM CONST AME36_PALAM_TEMP_12 = 1033
#DIM CONST AME36_PALAM_TEMP_13 = 1034
