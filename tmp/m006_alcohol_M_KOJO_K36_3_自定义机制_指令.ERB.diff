     CALL M_KOJO_AME_COLOR_K36
     RETURN 1
+
+;==================================================
+;按本体可饮用目录显示酒名，标记按酒数据ID查询
+;沿用本体ITEMNAME_TR翻译，不维护额外赋名表
+;==================================================
+@AME36_ALCOHOL_HISTORY_PRINT(CHARA)
+    #LOCALSIZE 1
+    #LOCALSSIZE 1
+    #DIM CHARA
+    #DIM DYNAMIC ALCOHOL_ID
+    #DIM DYNAMIC ITEM_ID
+    SIF CHARA < 0 || CHARA >= CHARANUM
+        RETURN 0
+    SIF NO:CHARA != 36
+        RETURN 0
+    LOCAL = 0
+    FOR ALCOHOL_ID, AME36_ALCOHOL_HISTORY_FIRST_ID, AME36_ALCOHOL_HISTORY_LAST_ID + 1
+        ITEM_ID = AME36_ALCOHOL_ITEM_INDEX(ALCOHOL_ID)
+        SIF ITEM_ID < 0
+            CONTINUE
+        LOCALS '= ITEMNAME_TR(ITEM_ID)
+        SIF LOCALS == ""
+            CONTINUE
+        SIF AME36_ALCOHOL_HISTORY_HAS(CHARA, ALCOHOL_ID)
+            SETCOLOR C_GREEN
+        STRLENFORM %LOCALS%
+        PRINTFORM %LOCALS%%"　" * MAX(8 - RESULT / 2, 1)%
+        RESETCOLOR
+        LOCAL += 1
+        SIF LOCAL % 3 == 0
+            PRINTL
+    NEXT
+    SIF LOCAL % 3
+        PRINTL
+    RETURN LOCAL
 
 ;==================================================
