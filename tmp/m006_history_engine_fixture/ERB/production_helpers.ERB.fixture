@AME36_FALL_STATE
	#LOCALSIZE 1
	#LOCALSSIZE 1
	#FUNCTION
	IF TALENT:LOVER_AMER
		RETURNF 4
	ELSEIF TALENT:AFFECTION_AMER
		RETURNF 3
	ELSEIF TALENT:YEARNING_AMER
		RETURNF 2
	ELSEIF CFLAG:AME36_ACQUAINTANCE
		RETURNF 1
	ENDIF
	RETURNF 0

;==================================================
;额外的一些小东西
;==================================================

@AME36_DISH_RECOLLECTION
	#LOCALSIZE 2
	#LOCALSSIZE 1
	#FUNCTION
	LOCAL = AME36_DISH_HISTORY_COUNT(TARGET, AME36_DISH_HISTORY_FIRST_ID, AME36_DISH_SPECIAL_OFFSET - 1)
	LOCAL = 1700 * LOCAL / 174
	LOCAL:1 = AME36_DISH_HISTORY_COUNT(TARGET, AME36_DISH_SPECIAL_OFFSET + 1, AME36_DISH_HISTORY_LAST_ID)
	IF AME36_DISH_HISTORY_HAS(TARGET, AME36_DISH_SELF_ID)
		LOCAL += 100
		LOCAL:1 -= 1
	ENDIF
	LOCAL += 50 * MIN(LOCAL:1, 4)
	SELECTCASE AME36_FALL_STATE()
		CASE 0
			RETURNF 0
		CASE 1
			RETURNF MIN(LOCAL, 400)
		CASE 2
			RETURNF MIN(LOCAL, 1000)
		CASE 3, 4
			RETURNF MIN(LOCAL, 2000)
	ENDSELECT
	
;==================================================
;记录已确认成功制作的料理，1为新增、0为重复、-1为输入无效
;普通空号的有效性由成功制作入口保证，允许固有料理的剧本覆写
;==================================================

@AME36_DISH_HISTORY_RECORD(CHARA, DISH_ID)
	#LOCALSIZE 1
	#LOCALSSIZE 1
	#FUNCTION
	#DIM CHARA
	#DIM DISH_ID
	SIF CHARA < 0 || CHARA >= CHARANUM
		RETURNF -1
	SIF NO:CHARA != 36
		RETURNF -1
	SIF !INRANGE(DISH_ID, AME36_DISH_HISTORY_FIRST_ID, AME36_DISH_HISTORY_LAST_ID)
		RETURNF -1
	SIF GROUPMATCH(DISH_ID, AME36_DISH_DEBUG_ID, AME36_DISH_SPECIAL_OFFSET)
		RETURNF -1
	LOCAL = DISH_ID - AME36_DISH_HISTORY_FIRST_ID
	;--------------------------------------------------
	;动态属性索引：料理历史1252～1259，位号始终为0～62
	;--------------------------------------------------
	SIF GETBIT(CFLAG:CHARA:(AME36_DISH_HISTORY_BEGIN + LOCAL / AME36_DISH_HISTORY_BITS), LOCAL % AME36_DISH_HISTORY_BITS)
		RETURNF 0
	;--------------------------------------------------
	;动态属性索引：料理历史1252～1259，不使用符号位
	;--------------------------------------------------
	SETBIT CFLAG:CHARA:(AME36_DISH_HISTORY_BEGIN + LOCAL / AME36_DISH_HISTORY_BITS), LOCAL % AME36_DISH_HISTORY_BITS
	RETURNF 1

;==================================================
;按料理编号读取历史标记，不改变TARGET或料理实例
;==================================================

@AME36_DISH_HISTORY_HAS(CHARA, DISH_ID)
	#LOCALSIZE 1
	#LOCALSSIZE 1
	#FUNCTION
	#DIM CHARA
	#DIM DISH_ID
	SIF CHARA < 0 || CHARA >= CHARANUM
		RETURNF 0
	SIF NO:CHARA != 36
		RETURNF 0
	SIF !INRANGE(DISH_ID, AME36_DISH_HISTORY_FIRST_ID, AME36_DISH_HISTORY_LAST_ID)
		RETURNF 0
	SIF GROUPMATCH(DISH_ID, AME36_DISH_DEBUG_ID, AME36_DISH_SPECIAL_OFFSET)
		RETURNF 0
	LOCAL = DISH_ID - AME36_DISH_HISTORY_FIRST_ID
	;--------------------------------------------------
	;动态属性索引：料理历史1252～1259，位号始终为0～62
	;--------------------------------------------------
	RETURNF GETBIT(CFLAG:CHARA:(AME36_DISH_HISTORY_BEGIN + LOCAL / AME36_DISH_HISTORY_BITS), LOCAL % AME36_DISH_HISTORY_BITS)

;==================================================
;统计指定编号区间的料理记录，排除DEBUG料理和保留编号
;只读取历史，不查询制作条件、材料或数据库
;==================================================

@AME36_DISH_HISTORY_COUNT(CHARA, FIRST_ID, LAST_ID)
	#LOCALSIZE 1
	#LOCALSSIZE 1
	#FUNCTION
	#DIM CHARA
	#DIM FIRST_ID
	#DIM LAST_ID
	#DIM DYNAMIC DISH_ID
	#DIM DYNAMIC OFFSET
	SIF CHARA < 0 || CHARA >= CHARANUM
		RETURNF 0
	SIF NO:CHARA != 36
		RETURNF 0
	FIRST_ID = MAX(FIRST_ID, AME36_DISH_HISTORY_FIRST_ID)
	LAST_ID = MIN(LAST_ID, AME36_DISH_HISTORY_LAST_ID)
	SIF FIRST_ID > LAST_ID
		RETURNF 0
	LOCAL = 0
	FOR DISH_ID, FIRST_ID, LAST_ID + 1
		SIF GROUPMATCH(DISH_ID, AME36_DISH_DEBUG_ID, AME36_DISH_SPECIAL_OFFSET)
			CONTINUE
		OFFSET = DISH_ID - AME36_DISH_HISTORY_FIRST_ID
		;--------------------------------------------------
		;动态属性索引：料理历史1252～1259，逐位计数避免跨类别混算
		;--------------------------------------------------
		LOCAL += GETBIT(CFLAG:CHARA:(AME36_DISH_HISTORY_BEGIN + OFFSET / AME36_DISH_HISTORY_BITS), OFFSET % AME36_DISH_HISTORY_BITS)
	NEXT
	RETURNF LOCAL

;==================================================
;获取一个数字所有二进制位值的和
;==================================================

@AME36_MAX_RECOLLECTION
	#LOCALSIZE 1
	#LOCALSSIZE 1
	#FUNCTION
	FOR LOCAL, 1201, AME36_DISH_HISTORY_BEGIN
		;--------------------------------------------------
		;属性索引：测试工具访问1201～1251，料理历史另按目录记录
		;--------------------------------------------------
		CFLAG:LOCAL = 99999
	NEXT
	CFLAG:AME36_RECOLLECTION_303 = 0
	;--------------------------------------------------
	;按现有目录记录料理，不将普通整数当作料理位图写入
	;--------------------------------------------------
	FOR LOCAL, AME36_DISH_HISTORY_FIRST_ID, AME36_DISH_HISTORY_LAST_ID + 1
		SIF !QOL_DISH_HAS_DATA(LOCAL)
			CONTINUE
		CALLF AME36_DISH_HISTORY_RECORD, TARGET, LOCAL
	NEXT
	RETURNF 1

@AME36_DISH_HISTORY_PRINT_RANGE(CHARA, FIRST_ID, LAST_ID, RECORDED_ONLY = 0)
    #LOCALSIZE 1
    #LOCALSSIZE 1
    #DIM CHARA
    #DIM FIRST_ID
    #DIM LAST_ID
    #DIM RECORDED_ONLY
    #DIM DYNAMIC DISH_ID
    SIF CHARA < 0 || CHARA >= CHARANUM
        RETURN 0
    SIF NO:CHARA != 36
        RETURN 0
    FIRST_ID = MAX(FIRST_ID, AME36_DISH_HISTORY_FIRST_ID)
    LAST_ID = MIN(LAST_ID, AME36_DISH_HISTORY_LAST_ID)
    SIF FIRST_ID > LAST_ID
        RETURN 0
    LOCAL = 0
    FOR DISH_ID, FIRST_ID, LAST_ID + 1
        SIF GROUPMATCH(DISH_ID, AME36_DISH_DEBUG_ID, AME36_DISH_SPECIAL_OFFSET)
            CONTINUE
        SIF RECORDED_ONLY && !AME36_DISH_HISTORY_HAS(CHARA, DISH_ID)
            CONTINUE
        SIF !RECORDED_ONLY && !QOL_DISH_HAS_DATA(DISH_ID)
            CONTINUE
        CALL DISHDATA(DISH_ID)
        SIF DISH_NAME == ""
            CONTINUE
        SIF AME36_DISH_HISTORY_HAS(CHARA, DISH_ID)
            SETCOLOR C_GREEN
        STRLENFORM %DISH_NAME%
        PRINTFORM %DISH_NAME%%"　" * MAX(10 - RESULT / 2, 1)%
        RESETCOLOR
        LOCAL += 1
        SIF LOCAL % 4 == 0
            PRINTL
    NEXT
    SIF LOCAL % 4
        PRINTL
    RETURN LOCAL

;==================================================
;为了简化代码的一个工具函数
;==================================================

