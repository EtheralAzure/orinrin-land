+;==================================================
+;记录已确认成功制作的料理，1为新增、0为重复、-1为输入无效
+;普通空号的有效性由成功制作入口保证，允许固有料理的剧本覆写
+;==================================================
+@AME36_DISH_HISTORY_RECORD(CHARA, DISH_ID)
+	#LOCALSIZE 1
+	#LOCALSSIZE 1
+	#FUNCTION
+	#DIM CHARA
+	#DIM DISH_ID
+	SIF CHARA < 0 || CHARA >= CHARANUM
+		RETURNF -1
+	SIF NO:CHARA != 36
+		RETURNF -1
+	SIF !INRANGE(DISH_ID, AME36_DISH_HISTORY_FIRST_ID, AME36_DISH_HISTORY_LAST_ID)
+		RETURNF -1
+	SIF GROUPMATCH(DISH_ID, AME36_DISH_DEBUG_ID, AME36_DISH_SPECIAL_OFFSET)
+		RETURNF -1
+	LOCAL = DISH_ID - AME36_DISH_HISTORY_FIRST_ID
+	;--------------------------------------------------
+	;动态属性索引：料理历史1252～1259，位号始终为0～62
+	;--------------------------------------------------
+	SIF GETBIT(CFLAG:CHARA:(AME36_DISH_HISTORY_BEGIN + LOCAL / AME36_DISH_HISTORY_BITS), LOCAL % AME36_DISH_HISTORY_BITS)
+		RETURNF 0
+	;--------------------------------------------------
+	;动态属性索引：料理历史1252～1259，不使用符号位
+	;--------------------------------------------------
+	SETBIT CFLAG:CHARA:(AME36_DISH_HISTORY_BEGIN + LOCAL / AME36_DISH_HISTORY_BITS), LOCAL % AME36_DISH_HISTORY_BITS
+	RETURNF 1
+
+;==================================================
+;按料理编号读取历史标记，不改变TARGET或料理实例
+;==================================================
+@AME36_DISH_HISTORY_HAS(CHARA, DISH_ID)
+	#LOCALSIZE 1
+	#LOCALSSIZE 1
+	#FUNCTION
+	#DIM CHARA
+	#DIM DISH_ID
+	SIF CHARA < 0 || CHARA >= CHARANUM
+		RETURNF 0
+	SIF NO:CHARA != 36
+		RETURNF 0
+	SIF !INRANGE(DISH_ID, AME36_DISH_HISTORY_FIRST_ID, AME36_DISH_HISTORY_LAST_ID)
+		RETURNF 0
+	SIF GROUPMATCH(DISH_ID, AME36_DISH_DEBUG_ID, AME36_DISH_SPECIAL_OFFSET)
+		RETURNF 0
+	LOCAL = DISH_ID - AME36_DISH_HISTORY_FIRST_ID
+	;--------------------------------------------------
+	;动态属性索引：料理历史1252～1259，位号始终为0～62
+	;--------------------------------------------------
+	RETURNF GETBIT(CFLAG:CHARA:(AME36_DISH_HISTORY_BEGIN + LOCAL / AME36_DISH_HISTORY_BITS), LOCAL % AME36_DISH_HISTORY_BITS)
+
+;==================================================
+;统计指定编号区间的料理记录，排除DEBUG料理和保留编号
+;只读取历史，不查询制作条件、材料或数据库
+;==================================================
+@AME36_DISH_HISTORY_COUNT(CHARA, FIRST_ID, LAST_ID)
+	#LOCALSIZE 1
+	#LOCALSSIZE 1
+	#FUNCTION
+	#DIM CHARA
+	#DIM FIRST_ID
+	#DIM LAST_ID
+	#DIM DYNAMIC DISH_ID
+	#DIM DYNAMIC OFFSET
+	SIF CHARA < 0 || CHARA >= CHARANUM
+		RETURNF 0
+	SIF NO:CHARA != 36
+		RETURNF 0
+	FIRST_ID = MAX(FIRST_ID, AME36_DISH_HISTORY_FIRST_ID)
+	LAST_ID = MIN(LAST_ID, AME36_DISH_HISTORY_LAST_ID)
+	SIF FIRST_ID > LAST_ID
+		RETURNF 0
+	LOCAL = 0
+	FOR DISH_ID, FIRST_ID, LAST_ID + 1
+		SIF GROUPMATCH(DISH_ID, AME36_DISH_DEBUG_ID, AME36_DISH_SPECIAL_OFFSET)
+			CONTINUE
+		OFFSET = DISH_ID - AME36_DISH_HISTORY_FIRST_ID
+		;--------------------------------------------------
+		;动态属性索引：料理历史1252～1259，逐位计数避免跨类别混算
+		;--------------------------------------------------
+		LOCAL += GETBIT(CFLAG:CHARA:(AME36_DISH_HISTORY_BEGIN + OFFSET / AME36_DISH_HISTORY_BITS), OFFSET % AME36_DISH_HISTORY_BITS)
+	NEXT
+	RETURNF LOCAL
+
