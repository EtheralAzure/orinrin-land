;==================================================
;取得当前料理编号，并保留自定义料理标记
;一定要把写料理系统的家伙头砍下来挂在地灵殿门口
;==================================================
@AME36_DISH_INDEX(ARGS)
	#LOCALSIZE 1
	#LOCALSSIZE 1
	#DIMS TDISH_NAME
	#DIMS TDISH_TASTE
	#DIMS TDISH_TYPE
	#DIMS TDISH_COMMENT
	#DIM TDISH_ING, 11
	#DIM TDISH_TIME
	#DIM TDISH_MAXLIMIT
	#DIM DYNAMIC RESULT_NO
	TDISH_NAME '= DISH_NAME
	TDISH_TASTE '= DISH_TASTE
	TDISH_TYPE '= DISH_TYPE
	TDISH_COMMENT '= DISH_COMMENT
	FOR LOCAL, 0, 11
		TDISH_ING:LOCAL = DISH_ING:LOCAL
	NEXT
	TDISH_TIME = DISH_TIME
	TDISH_MAXLIMIT = DISH_MAXLIMIT

	;--------------------------------------------------
	;属性索引：FLAG:20为当前料理编号，在COM413成功后读取
	;--------------------------------------------------
	RESULT_NO = FLAG:20
	VARSET RESULT
	IF RESULT_NO > 400
		TRYCALLFORM SPECIAL_MENU_{RESULT_NO - 400}
		SIF DISH_NAME != ARGS
			VARSET RESULT
			RESULT:1 = 1
	ENDIF

	DISH_NAME '= TDISH_NAME
	DISH_TASTE '= TDISH_TASTE
	DISH_TYPE '= TDISH_TYPE
	DISH_COMMENT '= TDISH_COMMENT
	FOR LOCAL, 0, 11
		DISH_ING:LOCAL = TDISH_ING:LOCAL
	NEXT
	DISH_TIME = TDISH_TIME
	DISH_MAXLIMIT = TDISH_MAXLIMIT

	RETURN RESULT_NO

;==================================================
;根据条件打印按钮或纯文本的函数
;==================================================
@AME36_CONDITIONAL_PRINT(ARGS, ARG)
	#LOCALSIZE 1
	#LOCALSSIZE 1
	IF ARG
		PRINTFORML %ARGS%
	ELSE
		LOCAL = GETCOLOR()
		SETCOLOR C_GRAY
		PRINTPLAINFORM %ARGS%
		PRINTL
		SETCOLOR LOCAL
	ENDIF

;==================================================
;自用的报错信息，出现了不该出现的情况时调用
;==================================================
@AME36_ERROR(ARG, ARGS)
	#LOCALSIZE 1
	#LOCALSSIZE 1
	DRAWLINE
	LOCAL = GETCOLOR()
	CALL M_KOJO_AME_COLOR_K36
	CALL AME36_AA(RAND:8, "CENTER")
	ALIGNMENT CENTER
	PRINTL ╭━━━━━━━━━━━━━━━━━━━━━╮
	PRINTL │　　　　　　　　　　　　　　　　　　　　　┃
	PRINTL │　　　　　　　　出错啦——　　　　　　　　┃
	PRINTL │　　到底是怎么回事呢？怎么会变成这样呢？　┃
	PRINTL │　　这种事情的话、请一定要告诉作者的说　　┃
	PRINTL │　　　　　　　　　　　　　　　　　　　　　┃
	PRINTL ╰━━━━━━━━━━━━━━━━━━━━━╯
	PRINTL
	ALIGNMENT LEFT
	SETCOLOR LOCAL
	FORCEWAIT
	FORCEWAIT
	FORCEWAIT

;==================================================
;清屏，做着好玩的
;==================================================
@AME36_WIPE
	#LOCALSIZE 2
	#LOCALSSIZE 1
	#DIM CONST INTERVALS = 1000, 800, 650, 500, 400, 300, 250, 200, 160, 130, 110, 100, 90, 80, 70, 60, 50, 40, 30, 20
	#DIM ORG_LINECOUNT
	ORG_LINECOUNT = LINECOUNT
	FOR LOCAL, 0, 20
		CLEARLINE 1
		TWAIT INTERVALS:LOCAL, 1
	NEXT
	FOR LOCAL, 1, 10
		FOR LOCAL:1, 1, LOCAL
			CLEARLINE LOCAL
			TWAIT 10, 1
		NEXT
	NEXT
	WHILE LINECOUNT > 270
		CLEARLINE 10
	WEND
	CLEARLINE LINECOUNT - 260
	FOR LOCAL, 1, 10
		FOR LOCAL:1, 1, 10 - LOCAL
			CLEARLINE 10 - LOCAL
			TWAIT 10, 1
		NEXT
	NEXT
	FOR LOCAL, 0, 20
		CLEARLINE 1
		TWAIT INTERVALS:(19 - LOCAL), 1
	NEXT
	CLEARLINE 1
	RETURN 0

