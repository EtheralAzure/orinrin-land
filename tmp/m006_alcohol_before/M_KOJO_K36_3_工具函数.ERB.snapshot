@AME36_CLEAR_SOURCE()
	#LOCALSIZE 1
	#LOCALSSIZE 1
	SOURCE:SLIQUID_AMER = 0
	SOURCE:SLOVE_AMER = 0
	SOURCE:SSEXACT_AMER = 0
	SOURCE:SACHIEVEMENT_AMER = 0
	SOURCE:SPAIN_AMER = 0
	SOURCE:SFEAR_AMER = 0
	SOURCE:SLUST_AMER = 0
	SOURCE:SRESPECT_AMER = 0
	SOURCE:SEXPOSURE_AMER = 0
	SOURCE:SSUBMISSION_AMER = 0
	SOURCE:SJOY_AMER = 0
	SOURCE:SCONQUEST_AMER = 0
	SOURCE:SPASSIVITY_AMER = 0
	SOURCE:SFILTH_AMER = 0
	SOURCE:SDEPRESSION_AMER = 0
	SOURCE:SDEVIATION_AMER = 0
	SOURCE:SHATE_AMER = 0
	SOURCE:SALLURE_AMER = 0
	SOURCE:SINSULT_AMER = 0
	SOURCE:SINDUCTION_AMER = 0
	SOURCE:SSERVE_AMER = 0
	SOURCE:SCOMPULSION_AMER = 0
	SOURCE:SABUSE_AMER = 0
	RETURN 1

;==================================================
;清除所有快感SOURCE
;==================================================
@AME36_CLEAR_PLEASURE_SOURCE()
	#LOCALSIZE 1
	#LOCALSSIZE 1
	SOURCE:SC_AMER = 0
	SOURCE:SV_AMER = 0
	SOURCE:SA_AMER = 0
	SOURCE:SB_AMER = 0
	SOURCE:SM_AMER = 0
	RETURN 1

