;※※※※※※※※※※※※※※※※※※※※※※※※※※※※
;DQ系：想要一字一顿地说话！
;依赖ERH中定义的AME36_DQ_ARRAY和AME36_DQ_SARRAY这两个数组运行
;最大支持文本长度198字符（不管全角半角都算一个）
;※※※※※※※※※※※※※※※※※※※※※※※※※※※※

;==================================================
;初始化函数，将文本打碎成单字储存
;默认颜色为系统默认值，无特殊格式，每40ms输出一个字
;==================================================
@AME36_DQ_INITIALIZE(TEXT, COLOR = -1, STYLE = 0, INTERVAL = 40)
	#LOCALSIZE 1
	#LOCALSSIZE 1
	#DIMS TEXT
	#DIM COLOR
	#DIM STYLE
	#DIM INTERVAL
	#DIM LENGTH

	FOR LOCAL, 1, 200
		IF TEXT == ""
			AME36_DQ_SARRAY:LOCAL '= ""
			LENGTH = LOCAL - 1
			BREAK
		ENDIF
		SUBSTRING TEXT, 0, 1
		AME36_DQ_SARRAY:LOCAL '= RESULTS
		SUBSTRING TEXT, 1, 400
		TEXT '= RESULTS
	NEXT
	FOR LOCAL, 1, LENGTH + 1
		AME36_DQ_ARRAY:LOCAL:0 = COLOR
		AME36_DQ_ARRAY:LOCAL:1 = STYLE
		AME36_DQ_ARRAY:LOCAL:2 = INTERVAL
	NEXT

	RETURN 1

;==================================================
;改变文本其中一段的颜色，START默认为文本开头，FINISH默认为文本结尾
;==================================================
@AME36_DQ_SETCOLOR(COLOR, START = 1, FINISH = 0)
	#LOCALSIZE 1
	#LOCALSSIZE 1
	#DIM COLOR
	#DIM START
	#DIM FINISH
	IF FINISH == 0
		FOR LOCAL, START, 200
			SIF AME36_DQ_SARRAY:LOCAL == ""
				BREAK
			AME36_DQ_ARRAY:LOCAL:0 = COLOR
		NEXT
		RETURN 1
	ENDIF
	FOR LOCAL, START, FINISH + 1
		AME36_DQ_ARRAY:LOCAL:0 = COLOR
	NEXT

	RETURN 1

;==================================================
;改变文本其中一段为渐变色，START默认为文本开头，FINISH默认为文本结尾
;==================================================
@AME36_DQ_GRADIENT(COLOR1, COLOR2, START = 1, FINISH = 0)
	#LOCALSIZE 1
	#LOCALSSIZE 1
	#DIM COLOR1
	#DIM COLOR2
	#DIM START
	#DIM FINISH
	#DIM RED0
	#DIM RED1
	#DIM RED2
	#DIM GREEN0
	#DIM GREEN1
	#DIM GREEN2
	#DIM BLUE0
	#DIM BLUE1
	#DIM BLUE2
	RED1 = COLOR1 / 0x10000
	RED2 = COLOR2 / 0x10000
	GREEN1 = (COLOR1 / 0x100) % 0x100
	GREEN2 = (COLOR2 / 0x100) % 0x100
	BLUE1 = COLOR1 % 0x100
	BLUE2 = COLOR2 % 0x100
	IF FINISH == 0
		FOR LOCAL, 1, 200
			IF AME36_DQ_SARRAY:LOCAL == ""
				FINISH = LOCAL - 1
				BREAK
			ENDIF
		NEXT
	ENDIF

	FOR LOCAL, START, FINISH + 1
		RED0 = RED1 + (RED2 - RED1) * (LOCAL - START) / (FINISH - START)
		GREEN0 = GREEN1 + (GREEN2 - GREEN1) * (LOCAL - START) / (FINISH - START)
		BLUE0 = BLUE1 + (BLUE2 - BLUE1) * (LOCAL - START) / (FINISH - START)
		AME36_DQ_ARRAY:LOCAL:0 = RED0 * 0x10000 + GREEN0 * 0x100 + BLUE0
	NEXT

	RETURN 1

;==================================================
;改变文本其中一段为特殊格式，START默认为文本开头，FINISH默认为文本结尾
;==================================================
@AME36_DQ_SETSTYLE(STYLE, START = 1, FINISH = 0)
	#LOCALSIZE 1
	#LOCALSSIZE 1
	#DIM STYLE
	#DIM START
	#DIM FINISH
	IF FINISH == 0
		FOR LOCAL, START, 200
			SIF AME36_DQ_SARRAY:LOCAL == ""
				BREAK
			AME36_DQ_ARRAY:LOCAL:1 = STYLE
		NEXT
		RETURN 1
	ENDIF
	FOR LOCAL, START, FINISH + 1
		AME36_DQ_ARRAY:LOCAL:1 = STYLE
	NEXT

	RETURN 1

;==================================================
;改变文本其中一段的显示速度，START默认为文本开头，FINISH默认为文本结尾
;==================================================
@AME36_DQ_SETINTERVAL(INTERVAL, START = 1, FINISH = 0)
	#LOCALSIZE 1
	#LOCALSSIZE 1
	#DIM INTERVAL
	#DIM START
	#DIM FINISH
	IF FINISH == 0
		FOR LOCAL, START, 200
			SIF AME36_DQ_SARRAY:LOCAL == ""
				BREAK
			AME36_DQ_ARRAY:LOCAL:2 = INTERVAL
		NEXT
		RETURN 1
	ENDIF
	FOR LOCAL, START, FINISH + 1
		AME36_DQ_ARRAY:LOCAL:2 = INTERVAL
	NEXT

	RETURN 1

;==================================================
;改变文本其中一段为变速显示，START默认为文本开头，FINISH默认为文本结尾
;==================================================
@AME36_DQ_ACCELERATE(INTERVAL1, INTERVAL2, START = 1, FINISH = 0)
	#LOCALSIZE 1
	#LOCALSSIZE 1
	#DIM INTERVAL1
	#DIM INTERVAL2
	#DIM START
	#DIM FINISH
	IF FINISH == 0
		FOR LOCAL, 1, 200
			IF AME36_DQ_SARRAY:LOCAL == ""
				FINISH = LOCAL - 1
				BREAK
			ENDIF
		NEXT
	ENDIF

	FOR LOCAL, START, FINISH + 1
		AME36_DQ_ARRAY:LOCAL:2 = INTERVAL1 + (INTERVAL2 - INTERVAL1) * (LOCAL - START) / (FINISH - START)
	NEXT

	RETURN 1

;==================================================
;打印经过各种处理的文本，一字一顿说话
;==================================================
@AME36_DQ_PRINT(IF_WAIT = 1)
	#LOCALSIZE 2
	#LOCALSSIZE 1
	#DIM IF_WAIT
	#DIM CURRENT_COLOR
	#DIM CURRENT_STYLE
	CURRENT_COLOR = GETCOLOR()
	CURRENT_STYLE = GETSTYLE()

	FOR LOCAL, 1, 200
		IF AME36_DQ_SARRAY:LOCAL == ""
			SETCOLOR CURRENT_COLOR
			FONTSTYLE CURRENT_STYLE
			IF IF_WAIT
				PRINTFORMW
			ELSE
				PRINTFORML
			ENDIF
			BREAK
		ENDIF
		SIF LOCAL != 1
			TWAIT AME36_DQ_ARRAY:(LOCAL - 1):2, AME36_DQ_UNSKIPPABLE
			CLEARLINE 1
		FOR LOCAL:1, 1, LOCAL + 1
			IF AME36_DQ_ARRAY:(LOCAL:1):0 == -1
				RESETCOLOR
			ELSE
				SETCOLOR AME36_DQ_ARRAY:(LOCAL:1):0
			ENDIF
			FONTSTYLE AME36_DQ_ARRAY:(LOCAL:1):1
			PRINTFORM %AME36_DQ_SARRAY:(LOCAL:1)%
		NEXT
	NEXT

	RETURN 1

;※※※※※※※※※※※※※※※※※※※※※※※※※※※※
;测试专用函数
;※※※※※※※※※※※※※※※※※※※※※※※※※※※※

;==================================================
;测试用，提高回忆记录并填满当前目录的料理历史
;==================================================
@AME36_MAX_RECOLLECTION
	#LOCALSIZE 1
	#LOCALSSIZE 1
	#FUNCTION
	FOR LOCAL, 1201, AME36_DISH_HISTORY_BEGIN
		;--------------------------------------------------
		;属性索引：测试工具访问1201～1251，料理历史另按目录记录
		;--------------------------------------------------
		CFLAG:LOCAL = 99999
	NEXT
	CFLAG:AME36_RECOLLECTION_303 = 0
	;--------------------------------------------------
	;按现有目录记录料理，不将普通整数当作料理位图写入
	;--------------------------------------------------
	FOR LOCAL, AME36_DISH_HISTORY_FIRST_ID, AME36_DISH_HISTORY_LAST_ID + 1
		SIF !QOL_DISH_HAS_DATA(LOCAL)
			CONTINUE
		CALLF AME36_DISH_HISTORY_RECORD, TARGET, LOCAL
	NEXT
	RETURNF 1

;※※※※※※※※※※※※※※※※※※※※※※※※※※※※
;已弃用留档
;留个猫猫球，豆山了
;※※※※※※※※※※※※※※※※※※※※※※※※※※※※

;※※※※※※※※※※※※※※※※※※※※※※※※※※※※
;种子随机数生成器
;SEED：种子（任意整数）
;LIMIT：随机数上限，下限始终为0，结果范围 [0, LIMIT)
;基于xorshift32 + 多轮bit mixing实现
;种子细微变化时输出会出现巨大且无明显规律的变化（雪崩效应）
;※※※※※※※※※※※※※※※※※※※※※※※※※※※※
