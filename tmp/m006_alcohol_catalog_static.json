    {
      "id": 50,
      "name": "一夜奇稻田",
      "alcohol": "LOCAL = 500 + RAND:200\n\t;一夜奇稻田は酒耐性が高いほど酔いが回りやすい\n\tIF ARG != MASTER\n\t\tIF TALENT:ARG:酒耐性 == -1\n\t\t\tTIMES LOCAL, 1.1\n\t\tELSEIF TALENT:ARG:酒耐性 == 1\n\t\t\tTIMES LOCAL, 1.2\n\t\tELSEIF TALENT:ARG:酒耐性 == 2\n\t\t\tTIMES LOCAL, 1.7\n\t\tELSEIF TALENT:ARG:酒耐性 == 3\n\t\t\tTIMES LOCAL, 2.5\n\t\tELSEIF TALENT:ARG:酒耐性 == -2\n\t\t\tIF CFLAG:ARG:不會喝酒 >= 5\n\t\t\t\tTIMES LOCAL, 2.0\n\t\t\tELSEIF CFLAG:ARG:不會喝酒 >= 2\n\t\t\t\tTIMES LOCAL, 1.5\n\t\t\tELSE\n\t\t\t\tTIMES LOCAL, 1.0\n\t\t\tENDIF\n\t\tENDIF\n\tENDIF\n\tRETURNF @\"{LOCAL}\"",
      "item": 513
