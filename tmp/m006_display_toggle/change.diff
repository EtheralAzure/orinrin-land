-@AME36_COMPLETION_PRINT(PROGRESS, MAX_VALUE, IS_L)
+;显示完成度，可按需附加COM回忆曲线的原始经验输入
+;==================================================
+@AME36_COMPLETION_PRINT(PROGRESS, MAX_VALUE, IS_L, COM_EXP = 0, SHOW_EXP = 0)
     #LOCALSIZE 1
     #LOCALSSIZE 1
     #DIM PROGRESS
     #DIM MAX_VALUE
     #DIM IS_L
+    #DIM COM_EXP
+    #DIM SHOW_EXP
+    IF SHOW_EXP
+        LOCALS = ({PROGRESS}/{MAX_VALUE} + {COM_EXP})
+    ELSE
+        LOCALS = ({PROGRESS}/{MAX_VALUE})
+    ENDIF
     IF PROGRESS == MAX_VALUE
-        LOCALS = ({PROGRESS}/{MAX_VALUE})
         CALL COLORMESSAGE(LOCALS, C_GREEN, IS_L)
     ELSE
         IF IS_L
-            PRINTFORML ({PROGRESS}/{MAX_VALUE})
+            PRINTFORML %LOCALS%
         ELSE
-            PRINTFORM ({PROGRESS}/{MAX_VALUE})
+            PRINTFORM %LOCALS%
         ENDIF
     ENDIF
     RETURN 1