@SYSTEM_TITLE
#LOCALSIZE 1
#LOCALSSIZE 1
PRINTFORML ISO_BEGIN run=%ISO_RUN_ID%
ISO_ASSERTIONS = 1
IF ISO_KNOWN_VALUE() != 42
    ISO_FAILURES += 1
    PRINTFORML ISO_FAIL run=%ISO_RUN_ID% known_value
ENDIF
PRINTFORML ISO_END run=%ISO_RUN_ID% assertions={ISO_ASSERTIONS} failures={ISO_FAILURES}
SAVETEXT @"ISO_END run=%ISO_RUN_ID% assertions={ISO_ASSERTIONS} failures={ISO_FAILURES}", 0, 1, 1
OUTPUTLOG "isolated_output.log"
FORCE_QUIT
